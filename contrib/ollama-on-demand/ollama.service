[Unit]
Description=Ollama backend (started on demand by ollama-proxy.socket)
StopWhenUnneeded=yes

[Service]
ExecStart=/usr/bin/ollama serve
# wait until the API answers so the proxy never hits a closed port
ExecStartPost=/bin/sh -c 'for i in $(seq 1 100); do curl -sf http://127.0.0.1:11435/ >/dev/null && exit 0; sleep 0.2; done; exit 1'
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_ORIGINS=moz-extension://*
Environment=OLLAMA_KEEP_ALIVE=2m
Restart=on-failure

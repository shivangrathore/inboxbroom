{
  "manifest_version": 2,
  "name": "Inbox Broom",
  "version": "1.3.4",
  "description": "Sweeps junk out of Gmail from Firefox: bulk rules plus optional local AI (Ollama) to delete junk, label what you keep, and unsubscribe. No API keys, nothing leaves your machine.",
  "browser_specific_settings": {
    "gecko": {
      "id": "inboxbroom@shivangrathore.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["personalCommunications"]
      }
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "tabs",
    "notifications",
    "https://mail.google.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/compat.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "lib/compat.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Inbox Broom",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://github.com/shivangrathore/inboxbroom",
  "author": "Shivang Rathore",
  "optional_permissions": [
    "https://*/*"
  ]
}
